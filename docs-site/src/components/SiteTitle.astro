---
// Starlight's site title (logo and name), linking to the site's start page
// (the landing page, / or /ja/) instead of the first docs page. The landing
// page is outside the docs' `base` (/docs/), so these paths are written out
// here; change them if the landing page moves or a language is added.
import Default from '@astrojs/starlight/components/SiteTitle.astro';

const route = Astro.locals.starlightRoute;
route.siteTitleHref = route.locale === 'ja' ? '/ja/' : '/';
---

<Default />
