{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodels.jp/schema/decision/Decision/v1.0.0.json",
  "title": "Decision",
  "description": "One automated decision about one entity: the answers of a model to the questions of a rule set, with probabilities, and the resulting action.",
  "x-version": "1.0.0",
  "x-license-url": "https://datamodels.jp/LICENSE-CONTENT",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uri",
      "description": "Entity id (URN)"
    },
    "type": {
      "type": "string",
      "const": "Decision",
      "description": "Entity type"
    },
    "@context": {
      "description": "JSON-LD context of the entity, optional: a context URL or a list of context URLs",
      "oneOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "minItems": 1
        }
      ]
    },
    "refersTo": {
      "type": "string",
      "format": "uri",
      "description": "The entity the decision is about (the input). One of refersTo or externalReference is required",
      "x-ngsi": {
        "type": "Relationship",
        "target": "any"
      },
      "x-iri": "http://www.w3.org/ns/prov#used"
    },
    "externalReference": {
      "type": "string",
      "description": "What the decision is about when it is not an entity in the broker, for example an issue URL",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://datamodels.jp/ns/decision/externalReference"
    },
    "action": {
      "type": "string",
      "description": "The action the rules gave: what happens next (for example auto, review, publish, urgent). The values are defined by the rule set",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://datamodels.jp/ns/decision/action"
    },
    "answers": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "value",
              "probability"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Question name, as in the rule set"
              },
              "type": {
                "const": "noul"
              },
              "value": {
                "type": "boolean",
                "description": "Yes (true) or no (false)"
              },
              "probability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Probability of this value, as given by the model"
              }
            },
            "description": "A yes/no answer"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "value",
              "probability",
              "probabilities"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Question name, as in the rule set"
              },
              "type": {
                "const": "choice"
              },
              "value": {
                "type": "string",
                "description": "The chosen option"
              },
              "probability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Probability of this value, as given by the model"
              },
              "probabilities": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "description": "Probability of each option (choice) or level (score)",
                "minProperties": 1
              }
            },
            "description": "One option from a list"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "value",
              "probability",
              "probabilities"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Question name, as in the rule set"
              },
              "type": {
                "const": "score"
              },
              "value": {
                "type": "integer",
                "minimum": 0,
                "description": "The most likely level, from 0 (lowest)"
              },
              "probability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Probability of this value, as given by the model"
              },
              "probabilities": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "description": "Probability of each option (choice) or level (score)",
                "minProperties": 1,
                "propertyNames": {
                  "pattern": "^(0|[1-9][0-9]*)$"
                }
              }
            },
            "description": "A level on an ordered scale"
          }
        ]
      },
      "description": "The model's answers, one per question, each with its probability. Empty for a decision made by rules only; its model is then none",
      "x-ngsi": {
        "type": "JsonProperty"
      },
      "x-iri": "https://datamodels.jp/ns/decision/answers"
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "missing",
              "values",
              "source"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Fact name, as in the rule set"
              },
              "missing": {
                "const": false
              },
              "values": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                },
                "description": "The fact's fields, for example inside, rank and class for an area, or distance_m and name for the nearest feature; null when a field has no value"
              },
              "source": {
                "type": "string",
                "description": "Where the value came from, for example a layer and its date"
              }
            },
            "description": "A fact that was looked up"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "missing",
              "reason"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Fact name, as in the rule set"
              },
              "missing": {
                "const": true
              },
              "reason": {
                "enum": [
                  "no_location",
                  "unavailable",
                  "timeout",
                  "error"
                ],
                "description": "Why it is missing: no location in the input, no source configured, too slow, or an error"
              }
            },
            "description": "A fact that could not be looked up; rules that need it do not match"
          }
        ]
      },
      "description": "Every spatial fact the rule set asks for, as looked up for this decision (whether or not the matching rule used it), computed by spatial operations, not by the model: for example whether the place is inside a flood zone, or the distance to the nearest evacuation site",
      "x-ngsi": {
        "type": "JsonProperty"
      },
      "x-iri": "https://datamodels.jp/ns/decision/facts"
    },
    "profile": {
      "type": "string",
      "description": "Id of the rule set that asked the questions and turned the answers into the action",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://datamodels.jp/ns/decision/profile"
    },
    "profileVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Version of the rule set",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://datamodels.jp/ns/decision/profileVersion"
    },
    "policyRule": {
      "description": "Which rule gave the action: its index from 0 as text (\"0\", \"1\", ...), or \"default\" when no rule matched. The reason for the result",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*|default)$",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://datamodels.jp/ns/decision/policyRule"
    },
    "model": {
      "type": "string",
      "description": "Id of the model that answered; none for a decision made by rules only, with no model, whose answers are then an empty list",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://datamodels.jp/ns/decision/model"
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the decision was made",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "http://www.w3.org/ns/prov#endedAtTime"
    },
    "humanInvolvement": {
      "type": "string",
      "enum": [
        "dpv:HumanInvolvementForVerification",
        "dpv:HumanInvolvementForOversight",
        "dpv:HumanInvolvementForDecision",
        "dpv:HumanNotInvolved"
      ],
      "description": "How a person takes part, as a W3C DPV term: dpv:HumanInvolvementForVerification (a person checks before the action is taken), dpv:HumanInvolvementForOversight (the action is taken; a person can check and correct it later), dpv:HumanInvolvementForDecision (a person decides, the answers only inform), dpv:HumanNotInvolved",
      "x-ngsi": {
        "type": "VocabProperty"
      },
      "x-iri": "https://w3id.org/dpv#hasHumanInvolvement"
    },
    "reviewStatus": {
      "type": "string",
      "enum": [
        "pending",
        "resolved",
        "superseded"
      ],
      "description": "State of the check by a person: pending, resolved, or superseded (the check was still pending when a newer decision replaced this one, so it is no longer needed). Absent when no check was asked. Corrections of answers do not depend on it: they can come at any time",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://datamodels.jp/ns/decision/reviewStatus"
    },
    "finalAction": {
      "type": "string",
      "description": "The action after the check by a person",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://datamodels.jp/ns/decision/finalAction"
    },
    "reviewedBy": {
      "type": "string",
      "description": "Who resolved the check: an account, role or team identifier, not a personal name",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://datamodels.jp/ns/decision/reviewedBy",
      "x-personal-data": true
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the check was resolved",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://datamodels.jp/ns/decision/reviewedAt"
    },
    "corrections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "by",
          "at"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Question name"
          },
          "value": {
            "type": [
              "boolean",
              "string",
              "integer"
            ],
            "description": "The right answer according to a person"
          },
          "by": {
            "type": "string",
            "description": "Who corrected it: an account or role identifier, not a personal name",
            "x-personal-data": true
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "description": "When"
          },
          "note": {
            "type": "string",
            "description": "Why, in a sentence"
          }
        }
      },
      "description": "Answers corrected by a person (the ground truth for measuring the model). They can come at any time, also without a check (reviewStatus)",
      "x-ngsi": {
        "type": "JsonProperty"
      },
      "x-iri": "https://datamodels.jp/ns/decision/corrections",
      "x-personal-data": true
    },
    "wasInformedBy": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "The earlier decisions this one used, in a chain of decisions. Always an array in the key-values form, even with one decision. In DMN terms, the decisions this one requires",
      "x-ngsi": {
        "type": "Relationship",
        "target": "https://datamodels.jp/ns/decision/Decision",
        "multi": true
      },
      "x-iri": "http://www.w3.org/ns/prov#wasInformedBy"
    },
    "requiredDecisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "decision"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The name the rule set gives this earlier decision, for example check"
          },
          "decision": {
            "type": "string",
            "format": "uri",
            "description": "Id of the earlier decision. It must also be in wasInformedBy"
          }
        }
      },
      "description": "Which earlier decision played which part: one item per earlier decision, with the name the rule set gives it (each name once) and the decision's id. Every decision listed here must also be in wasInformedBy",
      "x-ngsi": {
        "type": "JsonProperty"
      },
      "x-iri": "https://datamodels.jp/ns/decision/requiredDecisions"
    },
    "replaces": {
      "type": "string",
      "format": "uri",
      "description": "The decision this one replaces. This one is the same rule set's decision about the same entity, made again, for example after a person checked one of the decisions it used",
      "x-ngsi": {
        "type": "Relationship",
        "target": "https://datamodels.jp/ns/decision/Decision"
      },
      "x-iri": "http://purl.org/dc/terms/replaces"
    }
  },
  "required": [
    "id",
    "type",
    "action",
    "answers",
    "profile",
    "profileVersion",
    "model",
    "decidedAt"
  ],
  "x-model-tags": "decision, AI, provenance",
  "anyOf": [
    {
      "required": [
        "refersTo"
      ]
    },
    {
      "required": [
        "externalReference"
      ]
    }
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "reviewStatus"
        ],
        "properties": {
          "reviewStatus": {
            "const": "resolved"
          }
        }
      },
      "then": {
        "required": [
          "finalAction",
          "reviewedBy",
          "reviewedAt"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "finalAction"
              ]
            },
            {
              "required": [
                "reviewedBy"
              ]
            },
            {
              "required": [
                "reviewedAt"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "answers"
        ],
        "properties": {
          "answers": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "properties": {
          "model": {
            "const": "none"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "const": "none"
          }
        }
      },
      "then": {
        "properties": {
          "answers": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "dependentRequired": {
    "requiredDecisions": [
      "wasInformedBy"
    ]
  },
  "additionalProperties": false
}
