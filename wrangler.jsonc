// Development config for the public engine. It uses the bundled example
// profiles and the mock model, so it runs without any Cloudflare resources.
// A real deployment uses its own config from a private config repository
// (see issue #10); never add account IDs or real bindings here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pointsman",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Outgoing fetches (review callbacks, OAuth client metadata) reach only
  // public addresses.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "observability": { "enabled": true },
  // Retries review callbacks that are due (src/callbacks.ts).
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    // "bundled": example profiles built into the Worker (development only).
    // "kv": profiles from the PROFILES KV namespace.
    "PROFILE_SOURCE": "bundled",
    // "mock": every model id is answered by the mock adapter.
    "MODEL_MODE": "mock",
    // "mock": fixed spatial facts (src/facts.ts). "gsi": GSI data (src/facts-gsi.ts).
    // "off": facts are missing.
    "FACTS_MODE": "mock"
  },
  // API tokens (see scripts/tokens.mjs). The id is a placeholder: in local
  // development (wrangler dev) KV is simulated, and real deployments set
  // their own namespace in the config repository.
  "kv_namespaces": [{ "binding": "TOKENS", "id": "local-dev-only" }],
  // Decision log. Placeholder id, as above. Apply migrations/ with
  // `pnpm db:migrate:local` before `pnpm dev`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pointsman",
      "database_id": "local-dev-only",
      "migrations_dir": "migrations"
    }
  ],
  // `pnpm dev:live`: real model calls through Workers AI and the AI Gateway
  // (needs `wrangler login`; costs a little per call). Profiles, tokens and the
  // decision log stay local. Bindings and vars are not inherited by
  // environments, so they are repeated here.
  "env": {
    "live": {
      "vars": {
        "PROFILE_SOURCE": "bundled",
        "MODEL_MODE": "workers-ai",
        "AI_GATEWAY_ID": "pointsman"
      },
      "ai": { "binding": "AI" },
      "kv_namespaces": [{ "binding": "TOKENS", "id": "local-dev-only" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pointsman",
          "database_id": "local-dev-only",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
