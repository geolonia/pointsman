{
  "name": "pointsman",
  "private": true,
  "description": "Decision service: typed questions in, typed answers, probabilities and an action out.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build-profiles.mjs && node scripts/build-openapi-validators.mjs",
    "dev": "pnpm build && wrangler dev",
    "typecheck": "pnpm build && wrangler types && tsc -p tsconfig.json && tsc -p test/worker/tsconfig.json",
    "test": "pnpm test:scripts && pnpm test:worker",
    "test:scripts": "node --test \"test/**/*.test.mjs\"",
    "test:worker": "pnpm build && vitest run",
    "validate:profiles": "node scripts/validate-profiles.mjs examples/profiles",
    "check": "pnpm typecheck && pnpm test && pnpm validate:profiles && pnpm deploy:dry-run",
    "deploy:dry-run": "pnpm build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.6",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "vitest": "~4.1.11",
    "wrangler": "^4.147.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.9.1",
  "dependencies": {
    "hono": "^4.13.13"
  }
}
